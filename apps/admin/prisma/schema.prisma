generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  nickname     String?
  avatar       String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studyRecords     UserStudyRecord[]
  questionProgress UserQuestionProgress[]
  dailyStats       UserDailyStat[]
  settings         UserSettings?
}

model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  unitSize Int    @default(20)
  theme    String @default("system")
  language String @default("zh")
  density  String @default("comfortable")
  // 「我的教材」：教材练习页默认落到对应版本 + 年级
  publisherId BigInt?
  publisher   Publisher? @relation(fields: [publisherId], references: [id])
  gradeLevel  Int?
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Category {
  id        BigInt   @id @default(autoincrement())
  name      String
  parentId  BigInt?
  sortOrder Int      @default(0)
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  questions Question[]

  @@index([parentId])
}

model Subject {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions        Question[]
  knowledgePoints  KnowledgePoint[]
  studyRecords     UserStudyRecord[]
  questionProgress UserQuestionProgress[]
  grades           Grade[]

  @@index([sortOrder])
}

model Question {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt
  category   Category @relation(fields: [categoryId], references: [id])
  subjectId  BigInt?
  subject    Subject? @relation(fields: [subjectId], references: [id])
  type       Int
  content    String   @db.Text
  analysis   String?  @db.Text
  difficulty Int      @default(1)
  score      Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  options           QuestionOption[]
  progress          UserQuestionProgress[]
  knowledgePoints   QuestionKnowledgePoint[]

  @@index([categoryId])
  @@index([subjectId])
}

model QuestionOption {
  id         BigInt   @id @default(autoincrement())
  questionId BigInt
  question   Question @relation(fields: [questionId], references: [id])
  optionKey  String   @db.Char(1)
  content    String   @db.Text
  isCorrect  Boolean  @default(false)
  sortNo     Int      @default(0)

  @@index([questionId])
}

model UserStudyRecord {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  // 考纲练习记录带分类；教材章节练习跨分类取题，categoryId 为空
  categoryId      BigInt?
  unitIndex       Int
  // 教材章节练习来源；考纲练习时为空。两种来源各自独立计算 unitIndex
  chapterId       BigInt?
  chapter         Chapter? @relation(fields: [chapterId], references: [id])
  // 学习时选择的筛选条件（null = 未筛选）；记录的是用户行为上下文，与题目自身的多对多知识点无关
  subjectId        BigInt?
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  knowledgePointId BigInt?
  knowledgePoint   KnowledgePoint? @relation(fields: [knowledgePointId], references: [id])
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  totalQuestions  Int
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)
  durationSeconds Int      @default(0)

  @@index([userId, startedAt])
  @@index([categoryId])
  @@index([chapterId])
}

model UserQuestionProgress {
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  questionId      BigInt
  question        Question @relation(fields: [questionId], references: [id])
  categoryId      BigInt
  // 练习时选择的筛选条件（null = 未筛选）
  subjectId        BigInt?
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  knowledgePointId BigInt?
  knowledgePoint   KnowledgePoint? @relation(fields: [knowledgePointId], references: [id])
  status          String   @default("unseen")
  lastPracticedAt DateTime?
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)

  @@id([userId, questionId])
  @@index([categoryId])
  @@index([subjectId])
  @@index([knowledgePointId])
}

model UserDailyStat {
  userId           String
  user             User   @relation(fields: [userId], references: [id])
  date             DateTime @db.Date
  questionsAnswered Int     @default(0)
  unitsCompleted   Int     @default(0)
  studyDuration    Int     @default(0)

  @@id([userId, date])
}

model KnowledgePoint {
  id        BigInt   @id @default(autoincrement())
  name      String
  parentId  BigInt?
  subjectId BigInt?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    KnowledgePoint?  @relation("KnowledgePointTree", fields: [parentId], references: [id])
  children  KnowledgePoint[] @relation("KnowledgePointTree")
  subject   Subject?         @relation(fields: [subjectId], references: [id])
  questions QuestionKnowledgePoint[]
  studyRecords UserStudyRecord[]
  questionProgress UserQuestionProgress[]
  chapterLinks KnowledgePointChapter[]
  gradeLinks   KnowledgePointGrade[]

  @@index([parentId])
  @@index([subjectId])
}

model QuestionKnowledgePoint {
  questionId       BigInt
  knowledgePointId BigInt

  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@id([questionId, knowledgePointId])
  @@index([knowledgePointId])
}

// ===== 教材版本维度 =====
// 注意：知识点主树是考纲维度（只有一套），Publisher/Grade/Chapter 是教材维度（多套）。
// 一个知识点可关联多个版本的多个年级、多个章节，通过 KnowledgePointChapter / KnowledgePointGrade 两张表维护。

model Publisher {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique          // 人教版 / 苏教版 / 北师大版 / 鲁教版 / 通用
  createdAt DateTime @default(now())

  grades   Grade[]
  chapters Chapter[]
  settings UserSettings[]
}

// 年级册别：subjectId + publisherId 联合唯一
// level 7/8/9, semester 1=上 2=下 0=全一册
model Grade {
  id          BigInt   @id @default(autoincrement())
  subjectId   BigInt
  subject     Subject  @relation(fields: [subjectId], references: [id])
  publisherId BigInt
  publisher   Publisher @relation(fields: [publisherId], references: [id])
  level       Int            // 7 / 8 / 9
  semester    Int            // 1=上 2=下 0=全一册
  name        String         // "七年级上" / "九年级全一册"
  sortOrder   Int      @default(0)

  chapters Chapter[]
  kpLinks  KnowledgePointGrade[]

  @@unique([subjectId, publisherId, level, semester])
  @@index([subjectId])
  @@index([publisherId])
}

// 教材章节树：每个 Grade 有独立的章节树
model Chapter {
  id         BigInt    @id @default(autoincrement())
  gradeId    BigInt
  grade      Grade     @relation(fields: [gradeId], references: [id])
  parentId   BigInt?
  parent     Chapter?  @relation("ChapterTree", fields: [parentId], references: [id])
  children   Chapter[] @relation("ChapterTree")
  publisherId BigInt?
  publisher  Publisher? @relation(fields: [publisherId], references: [id])
  name       String
  sortOrder  Int       @default(0)

  kpLinks      KnowledgePointChapter[]
  studyRecords UserStudyRecord[]

  @@index([gradeId])
  @@index([parentId])
}

// 知识点 ↔ 章节 关联（多对多核心表）
model KnowledgePointChapter {
  knowledgePointId BigInt
  chapterId        BigInt

  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  chapter        Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([knowledgePointId, chapterId])
  @@index([chapterId])
}

// 知识点 ↔ 年级 冗余关联（加速"按年级查知识点"查询）
model KnowledgePointGrade {
  knowledgePointId BigInt
  gradeId          BigInt

  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  grade          Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([knowledgePointId, gradeId])
  @@index([gradeId])
}
