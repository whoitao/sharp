generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  nickname     String?
  avatar       String?
  gender       String?
  phone        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studyRecords     UserStudyRecord[]
  questionProgress UserQuestionProgress[]
  dailyStats       UserDailyStat[]
  settings         UserSettings?
}

model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  unitSize Int    @default(20)
  theme    String @default("system")
  language String @default("zh")
  density  String @default("comfortable")
  // 全局学习范围：年级 + 科目 + 教材版本（「我的教材」）
  gradeId     BigInt?
  grade       Grade?     @relation(fields: [gradeId], references: [id])
  subjectId   BigInt?
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  publisherId BigInt?
  publisher   Publisher? @relation(fields: [publisherId], references: [id])
  // 「我的教材」：全局单选的教材；选中后年级/科目/版本都由教材反推
  textbookId  BigInt?
  textbook    Textbook?  @relation(fields: [textbookId], references: [id])
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Subject {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions        Question[]
  knowledgePoints  KnowledgePoint[]
  studyRecords     UserStudyRecord[]
  questionProgress UserQuestionProgress[]
  settings         UserSettings[]
  textbooks        Textbook[]

  @@index([sortOrder])
}

// 学段字典：小学 / 初中 / 高中 / 大学
model Stage {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  grades          Grade[]
  knowledgePoints KnowledgePoint[]
  textbooks       Textbook[]

  @@index([sortOrder])
}

// 年级字典：小学一年级 ~ 大学四年级，与科目/教材版本无关
model Grade {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique // 一年级 / 初一 / 高一 / 大一
  stageId   BigInt
  stage     Stage    @relation(fields: [stageId], references: [id])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  questions    Question[]
  studyRecords UserStudyRecord[]
  settings     UserSettings[]
  textbooks    Textbook[]

  @@index([stageId, sortOrder])
}

model Question {
  id         BigInt   @id @default(autoincrement())
  gradeId    BigInt?
  grade      Grade?   @relation(fields: [gradeId], references: [id])
  subjectId  BigInt?
  subject    Subject? @relation(fields: [subjectId], references: [id])
  type       Int
  content    String   @db.Text
  analysis   String?  @db.Text
  difficulty Int      @default(1)
  score      Int      @default(1)
  sortOrder  Int      @default(0)
  // 教材归属：教材同步题指向所属章节（章节自带年级/科目/版本），中考真题/模拟题/自建题为空。
  chapterId  BigInt?
  chapter    Chapter? @relation(fields: [chapterId], references: [id])
  // 题目来源：exam 真题 / textbook 教材同步 / mock 模拟 / custom 自建
  source     String   @default("custom")
  createdAt  DateTime @default(now())

  options           QuestionOption[]
  progress          UserQuestionProgress[]
  knowledgePoints   QuestionKnowledgePoint[]
  tags              QuestionTagLink[]

  @@index([gradeId])
  @@index([subjectId])
  @@index([chapterId])
  @@index([source])
}

model QuestionOption {
  id         BigInt   @id @default(autoincrement())
  questionId BigInt
  question   Question @relation(fields: [questionId], references: [id])
  optionKey  String   @db.Char(1)
  content    String   @db.Text
  isCorrect  Boolean  @default(false)
  sortNo     Int      @default(0)

  @@index([questionId])
}

// 题目标签：中考真题 / 模拟题 / 课后练习 / 竞赛题…
// type 区分用途：exam 考试类型 / source 题目来源 / difficulty 难度
model QuestionTag {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  type      String   @default("source")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  questions QuestionTagLink[]

  @@index([type, sortOrder])
}

model QuestionTagLink {
  questionId BigInt
  tagId      BigInt

  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      QuestionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

model UserStudyRecord {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  // 考纲练习的年级；教材练习由章节反推，不冗余
  gradeId         BigInt?
  grade           Grade?   @relation(fields: [gradeId], references: [id])
  unitIndex       Int
  // 教材章节练习来源；考纲练习时为空。两种来源各自独立计算 unitIndex
  chapterId       BigInt?
  chapter         Chapter? @relation(fields: [chapterId], references: [id])
  // 学习时选择的筛选条件（null = 未筛选）；记录的是用户行为上下文，与题目自身的多对多知识点无关
  subjectId        BigInt?
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  knowledgePointId BigInt?
  knowledgePoint   KnowledgePoint? @relation(fields: [knowledgePointId], references: [id])
  // 标签筛选上下文：升序逗号拼接的 tagId（如 "1,3"），空表示未筛选
  tagFilter       String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  totalQuestions  Int
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)
  durationSeconds Int      @default(0)

  @@index([userId, startedAt])
  @@index([gradeId])
  @@index([chapterId])
}

model UserQuestionProgress {
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  questionId      BigInt
  question        Question @relation(fields: [questionId], references: [id])
  // 练习时选择的筛选条件（null = 未筛选）
  subjectId        BigInt?
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  knowledgePointId BigInt?
  knowledgePoint   KnowledgePoint? @relation(fields: [knowledgePointId], references: [id])
  status          String   @default("unseen")
  lastPracticedAt DateTime?
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)

  @@id([userId, questionId])
  @@index([subjectId])
  @@index([knowledgePointId])
}

model UserDailyStat {
  userId           String
  user             User   @relation(fields: [userId], references: [id])
  date             DateTime @db.Date
  questionsAnswered Int     @default(0)
  unitsCompleted   Int     @default(0)
  studyDuration    Int     @default(0)

  @@id([userId, date])
}

model KnowledgePoint {
  id        BigInt   @id @default(autoincrement())
  name      String
  parentId  BigInt?
  subjectId BigInt?
  stageId   BigInt
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    KnowledgePoint?  @relation("KnowledgePointTree", fields: [parentId], references: [id])
  children  KnowledgePoint[] @relation("KnowledgePointTree")
  subject   Subject?         @relation(fields: [subjectId], references: [id])
  stage     Stage            @relation(fields: [stageId], references: [id])
  questions QuestionKnowledgePoint[]
  studyRecords UserStudyRecord[]
  questionProgress UserQuestionProgress[]

  @@index([parentId])
  @@index([subjectId])
  @@index([stageId, subjectId, parentId, sortOrder])
  @@unique([stageId, subjectId, parentId, name])
}

model QuestionKnowledgePoint {
  questionId       BigInt
  knowledgePointId BigInt

  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@id([questionId, knowledgePointId])
  @@index([knowledgePointId])
}

// ===== 教材版本维度 =====
// 知识点主树是考纲维度（只有一套），Publisher/Chapter 是教材维度（多套）。
// 题目通过 Question.chapterId 直接归属章节，通过 QuestionKnowledgePoint 归属考纲知识点，两条维度互不依赖。

model Publisher {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique          // 人教版 / 苏教版 / 北师大版 / 鲁教版 / 通用
  createdAt DateTime @default(now())

  settings UserSettings[]
  textbooks Textbook[]
}

// 「我的教材」：一本具体的教材（科目 × 版本 × 年级 × 学期）
// 由原来 Chapter.level=1 的册节点升级而来，章节通过 textbookId 归属教材
model Textbook {
  id          BigInt   @id @default(autoincrement())
  name        String   // 展示名，如「数学 · 北师大版 · 七年级上」
  publisherId BigInt
  publisher   Publisher @relation(fields: [publisherId], references: [id])
  subjectId   BigInt
  subject     Subject  @relation(fields: [subjectId], references: [id])
  stageId     BigInt
  stage       Stage    @relation(fields: [stageId], references: [id])
  gradeId     BigInt
  grade       Grade    @relation(fields: [gradeId], references: [id])
  semester    Int      @default(1) // 1=上册 2=下册 0=全一册
  coverUrl    String?  // 封面图（Supabase Storage 相对路径）
  isbn        String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters Chapter[]
  settings UserSettings[]

  @@unique([subjectId, gradeId, publisherId, semester])
  @@index([stageId, subjectId, sortOrder])
}

// 教材章节树：归属 Textbook，parentId 表示章 → 节
// level 1=章 2=节（原「册」层级由 Textbook 取代）
model Chapter {
  id         BigInt   @id @default(autoincrement())
  textbookId BigInt
  textbook   Textbook @relation(fields: [textbookId], references: [id])
  parentId   BigInt?
  parent     Chapter? @relation("ChapterTree", fields: [parentId], references: [id])
  children   Chapter[] @relation("ChapterTree")
  level      Int      @default(1) // 1=章 2=节
  name       String
  sortOrder  Int      @default(0)

  studyRecords UserStudyRecord[]
  questions    Question[]

  @@index([textbookId, parentId, sortOrder])
  @@index([parentId])
}

// ===== 文章模块 =====
// 文章分类为必填维度，一篇文章只属于一个分类
model ArticleCategory {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  articles Article[]

  @@index([sortOrder])
}

model Article {
  id          BigInt          @id @default(autoincrement())
  title       String
  summary     String?         @db.Text
  content     String          @db.Text
  categoryId  BigInt
  category    ArticleCategory @relation(fields: [categoryId], references: [id])
  // 发布频道：web / mobile，可单选或多选
  channels    String[]
  // 状态：draft 草稿 / published 已发布
  status      String          @default("draft")
  publishedAt DateTime?
  viewCount   Int             @default(0)
  sortOrder   Int             @default(0)
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}
