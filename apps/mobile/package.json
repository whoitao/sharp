{
  "name": "@sharp/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "sh -c 'set -a; [ ! -f ../../.env ] || . ../../.env; set +a; expo start --go --port \"${PORT_MOBILE:-8081}\"'",
    "android": "sh -c 'set -a; [ ! -f ../../.env ] || . ../../.env; set +a; expo run:android --port \"${PORT_MOBILE:-8081}\"'",
    "android:x64": "sh -c 'set -a; [ ! -f ../../.env ] || . ../../.env; set +a; expo run:android --device Pixel_API_34_x64 --port \"${PORT_MOBILE:-8081}\"'",
    "buildAndroidLocal": "eas build --platform android --local --profile preview",
    "buildAndroidLocalProduction": "eas build --platform android --local --profile production",
    "ios": "sh -c 'set -a; [ ! -f ../../.env ] || . ../../.env; set +a; expo run:ios --device \"iPhone 17\" --port \"${PORT_MOBILE:-8081}\"'",
    "ioss": "sh -c 'set -a; [ ! -f ../../.env ] || . ../../.env; set +a; expo start --ios --go --port \"${PORT_MOBILE:-8081}\"'",
    "web": "sh -c 'set -a; [ ! -f ../../.env ] || . ../../.env; set +a; expo start --web --port \"${PORT_MOBILE:-8081}\"'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@sharp/shared": "workspace:*",
    "axios": "^1.7.0",
    "babel-preset-expo": "~58.0.25",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lottie-react-native": "~7.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "expo-build-properties": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
