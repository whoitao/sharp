{
  "name": "sharp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "electron-to-chromium": "1.5.458"
    },
    "patchedDependencies": {
      "react-native-screens@4.11.1": "patches/react-native-screens+4.11.1.patch"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "admin:dev": "npm run dev --workspace=apps/admin",
    "admin:build": "npm run build --workspace=apps/admin",
    "mobile:dev": "npm run dev --workspace=apps/mobile",
    "web:dev": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/admin",
    "db:push": "npm run db:push --workspace=apps/admin",
    "db:seed": "npm run db:seed --workspace=apps/admin"
  },
  "engines": {
    "node": ">=18"
  }
}
